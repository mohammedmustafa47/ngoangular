{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python manage.py check)",
      "PowerShell($errs = $null; [void][System.Management.Automation.Language.Parser]::ParseFile\\(\"$PWD\\\\scripts\\\\setup-guardrails.ps1\", [ref]$null, [ref]$errs\\); if \\($errs\\) { $errs | ForEach-Object { \"$\\($_.Extent.StartLineNumber\\): $\\($_.Message\\)\" } } else { 'No syntax errors' })"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(gh:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.git/hooks/**)"
    ],
    "additionalDirectories": [
      "C:\\Users\\musta\\OneDrive\\Desktop\\djangoauth"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
